# Deny by default; the reviewed methods tree is the only publication scope.
/*
!/.gitignore
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CITATION.cff
!/PUBLIC_FILES.json
!/requirements.txt
!/package.json
!/methods/
/methods/**
!/methods/*.mjs
!/methods/*.py
!/method-tests/
/method-tests/**
!/method-tests/*.mjs
!/method-tests/*.py
!/public-docs/
/public-docs/**
!/public-docs/*.md
!/publication/
/publication/**
!/publication/check.py
!/assets/
/assets/**
!/assets/banner.png
!/sample/
/sample/**
!/sample/README.md
!/sample/features.geojson
!/sample/structures.geojson
!/sample/terrain.json
!/tutorial/
/tutorial/**
!/tutorial/*.mjs
!/tutorial/README.md
!/tutorial/expected.json
!/tutorial/preview.png
!/public-skills/
/public-skills/**
!/public-skills/*/
!/public-skills/*/SKILL.md
!/public-skills/README.md
!/.github/
/.github/**
!/.github/workflows/
!/.github/workflows/ci.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/method.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/PULL_REQUEST_TEMPLATE.md
**/__pycache__/
**/.DS_Store
**/.env*
